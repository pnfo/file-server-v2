---
import Layout from '../../layouts/Layout.astro'
import EntryTable from '../../components/EntryTable.astro'
import FileView from '../../components/FileView.astro'
import NotFound from '../../components/NotFound.astro'
import TopNav from '../../components/TopNav.astro'
import { parseId } from '../../lib/site.ts'
const s = Astro.locals.site
if (!s) return Astro.rewrite('/404')
const { cfg, store } = s
const id = parseId(Astro.params.id)
const entry = Number.isNaN(id) ? undefined : store.get(id)
if (!entry) Astro.response.status = 404
// always revalidate: edits (renames, previews, publish) must show at once, and file pages embed signed links
Astro.response.headers.set('Cache-Control', 'no-cache')
const description = !entry ? undefined : entry.kind === 'folder'
  ? `${entry.name} බහාලුමේ ඇති බෞද්ධ ${cfg.fileTypeName} බාගත කරගන්න.`
  : `${entry.name}.${entry.type} ${cfg.fileTypeName} බාගත කරගන්න.`
---
<Layout title={entry?.name} description={description} canonicalPath={entry ? String(entry.id) : undefined}>
  {!entry ? <NotFound /> : entry.kind === 'folder' ? (
    <>
      <TopNav parents={store.parents(entry.id)} current={{ name: entry.name }} shareId={entry.id} />
      <EntryTable entries={store.childrenOf(entry.id)} exclude={['parent']} />
    </>
  ) : <FileView file={entry} />}
</Layout>
