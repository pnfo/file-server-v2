---
import AdminLayout from '../../../layouts/AdminLayout.astro'
import Icon from '../../../components/Icon.astro'
import { checkPassword, COOKIE, createSession, loginAllowed, recordLogin } from '../../../lib/auth.ts'
import { clientKey } from '../../../lib/site.ts'
const s = Astro.locals.site
if (!s) return Astro.rewrite('/404')
let error = ''
if (Astro.request.method === 'POST') {
  const ip = clientKey(Astro.request, Astro.clientAddress)
  if (!loginAllowed(ip)) error = 'Too many attempts. Try again in 15 minutes.'
  else {
    const pw = String((await Astro.request.formData()).get('password') || '')
    const ok = checkPassword(pw)
    recordLogin(ip, ok)
    if (ok) {
      const { value, maxAge } = createSession()
      Astro.cookies.set(COOKIE, value, { path: s.base + '/admin', httpOnly: true, sameSite: 'strict', secure: import.meta.env.PROD && Astro.request.headers.get('x-forwarded-proto') !== 'http', maxAge })
      return Astro.redirect(`${s.base}/admin`)
    }
    error = 'Incorrect password.'
  }
}
---
<AdminLayout title="Sign in">
  <form method="post" class="card max-w-sm mx-auto mt-[12vh] p-7 flex flex-col gap-5">
    <div class="flex items-center gap-2.5">
      <span class="size-9 rounded-lg bg-primary/15 text-primary grid place-items-center text-lg"><Icon name="book" /></span>
      <div><p class="font-semibold text-[15px] leading-tight">Tipitaka.lk admin</p><p class="text-[13px] text-text-muted capitalize">{s.id}</p></div>
    </div>
    <div><label class="label" for="pw">Password</label><input id="pw" type="password" name="password" required autofocus class="field" />
      {error && <p class="text-[13px] text-rose-600 dark:text-rose-400 mt-1.5">{error}</p>}</div>
    <button class="btn-primary w-full">Sign in</button>
  </form>
</AdminLayout>
