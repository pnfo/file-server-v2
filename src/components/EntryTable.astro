---
// Server-rendered file/folder table. Sorting is done in the browser by client/site.ts, which
// re-orders these rows using their data-* attributes - there is no framework hydration (design D6).
import Icon from './Icon.astro'
import type { IconName } from './Icons.astro'
import type { Entry } from '../lib/db.ts'
import { fontClass, getSizeInfo, getTypeInfo, sizeUnitColor } from '../lib/format.ts'

export type Column = 'parent' | 'downloads' | 'dateAdded'
export type SortKey = 'name' | Column | 'size'
interface Props {
  entries: Entry[]
  exclude?: Column[]
  sort?: { key: SortKey; dir: 'asc' | 'desc' } // the order the server already sorted rows in
}
const { entries, exclude = [], sort = { key: 'name', dir: 'asc' } } = Astro.props
const { base, cfg, store } = Astro.locals.site!

// design-concerns.md rule 4: a folder-only list shows just name + size
const hasFiles = entries.some(e => e.kind === 'file')
const show = (c: Column) => hasFiles && !exclude.includes(c)
const headers: { key: SortKey; label: string; cls: string }[] = [
  { key: 'name', label: `${cfg.fileTypeName} නම`, cls: 'text-left' },
  ...(show('parent') ? [{ key: 'parent' as const, label: 'බහාලුම', cls: 'hidden sm:table-cell text-left w-48' }] : []),
  ...(show('downloads') ? [{ key: 'downloads' as const, label: 'බාගත ගණන', cls: 'hidden sm:table-cell text-right w-28' }] : []),
  ...(show('dateAdded') ? [{ key: 'dateAdded' as const, label: 'එක් කළ දිනය', cls: 'hidden sm:table-cell text-right w-32' }] : []),
  { key: 'size', label: 'ප්‍රමාණය', cls: 'text-right w-24 sm:w-28' },
]
const rows = entries.map(e => ({
  e, type: getTypeInfo(e.type), size: getSizeInfo(e.sizeBytes), parent: show('parent') ? store.parentOf(e) : undefined,
}))
const status = (key: SortKey, dir: string) =>
  `ඉහත ලැයිස්තුව “${headers.find(h => h.key === key)?.label ?? headers[0].label}” ${dir === 'desc' ? 'අඩුවන' : 'වැඩිවන'} පිළිවෙළට සැකසී ඇත.`
---
<div class="w-full" data-entry-table data-sort-key={sort.key} data-sort-dir={sort.dir}>
  <table class="w-full border-collapse text-base">
    <thead>
      <tr class="border-b border-border">
        {headers.map(h => (
          <th class={`py-2 px-2 font-normal ${h.cls}`} aria-sort={sort.key === h.key ? (sort.dir === 'asc' ? 'ascending' : 'descending') : undefined}>
            <button type="button" data-sort={h.key} data-label={h.label}
              class={`inline-flex items-center gap-1 hover:text-primary cursor-pointer ${h.cls.includes('text-right') ? 'flex-row-reverse' : ''}`}>
              <span>{h.label}</span>
              <Icon name="arrowUp" class={`text-primary ${sort.key === h.key && sort.dir === 'asc' ? '' : 'hidden'}`} />
              <Icon name="arrowDown" class={`text-primary ${sort.key === h.key && sort.dir === 'desc' ? '' : 'hidden'}`} />
            </button>
          </th>
        ))}
      </tr>
    </thead>
    <tbody class="divide-y divide-border/50">
      {rows.map(({ e, type, size, parent }) => (
        <tr class="hover:bg-surface-hover/60" data-kind={e.kind} data-name={e.name} data-size={e.sizeBytes}
          data-downloads={e.downloads} data-date={e.dateAdded} data-parent={parent?.name ?? ''}>
          <td class="py-1.5 px-2 align-middle">
            <div class="flex items-center gap-2">
              <Icon name={type.icon as IconName} class={`text-2xl ${type.color}`} />
              <div class="min-w-0 leading-snug">
                <a href={`${base}/${e.id}`} class={`text-link hover:text-primary ${fontClass(e.name)}`}>{e.name}</a>
                {e.kind === 'folder'
                  ? <span class="si text-xs text-text-muted ml-2 whitespace-nowrap">ගොනු {e.numEntries} කි.</span>
                  : e.version && <span class={`text-xs text-text-muted ml-2 ${fontClass(e.version)}`}>{e.version}</span>}
              </div>
            </div>
          </td>
          {show('parent') && (
            <td class="hidden sm:table-cell py-1.5 px-2 align-middle text-sm text-text-muted max-w-48 truncate">
              {parent && <a href={`${base}/${parent.id}`} class={`hover:text-primary ${fontClass(parent.name)}`}>{parent.name}</a>}
            </td>
          )}
          {show('downloads') && <td class="hidden sm:table-cell py-1.5 px-2 align-middle text-right text-sm text-text-muted tabular-nums">{e.kind === 'file' ? e.downloads : ''}</td>}
          {show('dateAdded') && <td class="hidden sm:table-cell py-1.5 px-2 align-middle text-right text-sm text-text-muted tabular-nums whitespace-nowrap">{e.kind === 'file' ? e.dateAdded : ''}</td>}
          <td class="py-1.5 px-2 align-middle text-right text-sm whitespace-nowrap tabular-nums">
            <span>{size.numeral}</span><span class={`text-xs ml-1 font-medium ${sizeUnitColor(size.unit)}`}>{size.unit}</span>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
  {!entries.length && <p class="py-6 text-center text-text-muted">මෙම බහාලුමේ ගොනු කිසිවක් නැත.</p>}
  {entries.length > 1 && (
    <p class="si flex items-center gap-2.5 text-base py-2 mt-1 border-t border-border/40">
      <Icon name="sort" class="text-info text-xl" /><span data-sort-status>{status(sort.key, sort.dir)}</span>
    </p>
  )}
</div>
