---
// Breadcrumbs. The share link (folder views only, concern 10) copies the canonical production URL.
import Icon from './Icon.astro'
import type { IconName } from './Icons.astro'
import type { Entry } from '../lib/db.ts'
import { fontClass } from '../lib/format.ts'
interface Props { parents: Entry[]; current?: { name: string; icon?: IconName }; shareId?: number }
const { parents, current, shareId } = Astro.props
const { base, cfg } = Astro.locals.site!
---
<div class="flex flex-wrap items-center justify-between gap-2 text-base py-1 mb-1">
  <nav aria-label="Breadcrumb" class="flex items-center flex-wrap gap-1.5 text-text">
    <a href={`${base}/`} class="hover:text-primary flex items-center text-lg" title="මුල් පිටුව"><Icon name="home" /></a>
    {parents.map(p => (
      <><Icon name="chevron" class="text-sm text-text-muted opacity-70" /><a href={`${base}/${p.id}`} class={`hover:text-primary ${fontClass(p.name)}`}>{p.name}</a></>
    ))}
    {current && (
      <><Icon name="chevron" class="text-sm text-text-muted opacity-70" /><span class={`text-text flex items-center gap-1 ${fontClass(current.name)}`} aria-current="page">{current.icon && <Icon name={current.icon} />}{current.name}</span></>
    )}
  </nav>
  {shareId !== undefined && (
    <button type="button" data-copy={cfg.webUrlRoot + shareId}
      class="text-info hover:text-primary flex items-center gap-1 py-0.5 px-2 rounded hover:bg-info/10">
      <Icon name="share" class="text-base" /><span>සබැඳිය</span>
    </button>
  )}
</div>
