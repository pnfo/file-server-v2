# systemd unit for the file server (/library, /cloud). Install: /etc/systemd/system/file_server.service
# deploy.sh uploads the binary, dist/ and config to ~/www/file_server; data/*.db stay there.
[Unit]
Description=Tipitaka.lk file server (library, cloud)
After=network.target

[Service]
Type=simple
User=janaka
WorkingDirectory=/home/janaka/www/file_server
ExecStart=/home/janaka/www/file_server/file_server serve
Environment=HOST=127.0.0.1 PORT=8090 LOG_REQUESTS=0
# README: serving part of the downloads from the droplet
Environment=DROPLET_BASE=https://tipitaka.lk/fs-dl DROPLET_SHARE=40
# soft limit for the Go GC (it collects harder near it), hard limit for the kernel
Environment=GOMEMLIMIT=60MiB
MemoryMax=150M
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

# sudo cp server/file_server.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now file_server
# journalctl -u file_server.service
